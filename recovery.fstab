# =============================================================================
# recovery.fstab — Xiaomi athens (Redmi K100 Pro) / Canoe / SM8850 / Android 16
#
# ★★★ 这个文件必须是 AOSP fs_mgr 格式，不是 TWRP v2 格式！ ★★★
#
#   格式: <src>  <mnt_point>  <fs_type>  <mnt_flags>  <fs_mgr_flags>
#
# -----------------------------------------------------------------------------
# 为什么必须是 AOSP 格式（这是 /data 解密失败的根本原因）
# -----------------------------------------------------------------------------
#   fs_mgr 在 **第一级 init (first stage)** 就读这个文件，把带
#   `first_stage_mount` 的分区挂载起来。这一步必须发生在
#   **第二级 init 解析 init.rc 之前**。
#
#   否则会发生什么（本项目实测到的完整故障链）:
#     1) /vendor 没挂
#     2) /vendor/etc/init/*.rc 从未被 import
#     3) vendor HAL 服务 (KeyMint / Gatekeeper / Weaver) 根本没注册
#        —— 它们都定义在 /vendor/etc/init/ 里
#     4) recovery 的 init.rc 里的 `class_start hal` 启动了个空
#     5) keystore2 绑不上 KeyMint -> SIGSEGV 崩溃循环
#        (keystore.crash_count 涨到 100)
#     6) TWRP 读不到 /vendor/etc/vintf/manifest_canoe.xml
#        -> 只能兜底猜 keymaster 4.x
#     7) **Unable to decrypt metadata encryption** -> FBE 解密失败
#
#   实测对照 —— 4 个同平台可用机型 (myron / annibale / nezha / songyuan)
#   **全部**使用 AOSP 格式，且 /system /vendor /odm 都带 first_stage_mount:
#       vendor  /vendor  erofs  ro  wait,slotselect,logical,first_stage_mount
#
# -----------------------------------------------------------------------------
# TWRP 专属的 flags 不要写在这里
# -----------------------------------------------------------------------------
#   `display=` / `backup=` / `flashimg=` 这些是 TWRP 自己的语法，fs_mgr 看不懂。
#   它们放在另一个文件: /system/etc/twrp.flags
#       -> 见 recovery/root/system/etc/twrp.flags
#
#   本文件只写 fs_mgr 需要的「可挂载文件系统」。
#   纯裸设备分区 (boot / recovery / dtbo / vbmeta / modem / ...) 不进这里，
#   只进 twrp.flags —— 与 songyuan 的做法一致。
#
#   数据来源: 原厂 vendor_boot.img 内 first_stage_ramdisk/fstab.qcom (实测提取)
# =============================================================================

# -----------------------------------------------------------------------------
# 动态分区 (位于 super 内, logical, A/B 槽位, erofs 只读)
#
#   ★ 全部 first_stage_mount —— 必须早于 init.rc 解析，
#     否则 vendor/odm 的 HAL 服务不会注册（见上方故障链）
# -----------------------------------------------------------------------------
system                 /system              erofs  ro  wait,slotselect,logical,first_stage_mount
system_ext             /system_ext          erofs  ro  wait,slotselect,logical,first_stage_mount
product                /product             erofs  ro  wait,slotselect,logical,first_stage_mount
vendor                 /vendor              erofs  ro  wait,slotselect,logical,first_stage_mount
vendor_dlkm            /vendor_dlkm         erofs  ro  wait,slotselect,logical,first_stage_mount
system_dlkm            /system_dlkm         erofs  ro  wait,slotselect,logical,first_stage_mount
odm                    /odm                 erofs  ro  wait,slotselect,logical,first_stage_mount
mi_ext                 /mi_ext              erofs  ro  wait,slotselect,logical,first_stage_mount,nofail

# -----------------------------------------------------------------------------
# 元数据分区 (本机实测为 f2fs, 不是 ext4)
#   metadata 加密的密钥目录就在这里:
#       /metadata/vold/metadata_encryption
#   也带 first_stage_mount —— 解密时需要读它
# -----------------------------------------------------------------------------
/dev/block/bootdevice/by-name/metadata  /metadata  f2fs  noatime,nosuid,nodev,discard  wait,check,formattable,first_stage_mount

# -----------------------------------------------------------------------------
# 用户数据分区 (f2fs + 文件级加密 FBE v2 + metadata 加密)
#   原厂 fstab.qcom 原文:
#       fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0
#       keydirectory=/metadata/vold/metadata_encryption
#       metadata_encryption=aes-256-xts:wrappedkey_v0
#   用 latemount —— 等解密完成后再挂载
# -----------------------------------------------------------------------------
/dev/block/bootdevice/by-name/userdata  /data  f2fs  noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier,inlinecrypt  latemount,wait,check,formattable,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption,metadata_encryption=aes-256-xts:wrappedkey_v0,quota,reservedsize=128M,sysfs_path=/sys/devices/platform/soc/1d84000.ufshc,checkpoint=fs

# -----------------------------------------------------------------------------
# 持久化分区 (TEE / 传感器校准 / 时间偏移)
# -----------------------------------------------------------------------------
/dev/block/bootdevice/by-name/persist  /persist  ext4  noatime,nosuid,nodev,barrier=1  wait

# -----------------------------------------------------------------------------
# 杂项 (A/B 启动控制块)
# -----------------------------------------------------------------------------
/dev/block/bootdevice/by-name/misc  /misc  emmc  defaults  defaults

# -----------------------------------------------------------------------------
# 外部存储 (USB OTG)
# -----------------------------------------------------------------------------
/devices/platform/soc/a600000.ssusb/*.dwc3/xhci-hcd.*.auto*  /usb_otg  auto  nosuid,nodev  wait,voldmanaged=usbotg:auto
